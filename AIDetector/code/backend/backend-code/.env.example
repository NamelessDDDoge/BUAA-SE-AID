AI_REMOTE_INFER_TIMEOUT=1800
AI_REMOTE_INFER_TOKEN=
AI_REMOTE_INFER_MAX_CONCURRENCY=1

# Local image detection execution. Defaults are conservative for a single 8GB GPU.
IMAGE_TASK_MAX_WORKERS=1
IMAGE_DETECTION_BATCH_SIZE=1
AI_SERVICE_SERIALIZE_LOCAL_INFER=1
AI_SERVICE_INFER_TIMEOUT=1800
